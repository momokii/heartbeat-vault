# ──────────────────────────────────────────────────────────────────────────
# Heartbeat Vault — environment template (.env.example)
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env — it is gitignored. This file contains placeholders only.
# Every variable used in docker-compose.yml / Caddyfile / app config is listed.
# ──────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────
# Active environment: development | staging | production
# Controls log verbosity, debug features, and compose override selection.
APP_ENV=development

# Log level for the API: debug | info | warn | error
LOG_LEVEL=debug

# ── Network / ports (host bindings via compose) ───────────────────────────
# Public HTTP/HTTPS as seen by the host (Caddy listens on :80/:443 inside).
# Default maps to 127.0.0.1:8080 → :80 and 127.0.0.1:8443 → :443 for LAN dev.
# Defaults use 18080/18443/15432/13001 to avoid clashing with common host services (8080/5432).
HTTP_PORT=18080
HTTPS_PORT=18443
# Host IP Caddy's published 80/443 bind to. Default 127.0.0.1 = loopback only.
# Set to your Tailnet IP (e.g. 100.124.184.116) to reach the app from tailnet
# devices; pair with HTTP_PORT=80 / HTTPS_PORT=443 for portless URLs.
# NEVER 0.0.0.0, ::, or a CIDR — scripts/verify-security.sh FAILs wildcards.
CADDY_BIND_IP=127.0.0.1

# API — internal container port (api:3000). Host debug exposure via override.
API_PORT=3000
# Host port for direct API access in dev (127.0.0.1:13001 → api:3000).
API_HOST_PORT=13001

# Postgres — internal is always 5432; host exposure only in dev override.
DB_PORT=15432

# Caddy admin API — only exposed in dev override (127.0.0.1:12019).
CADDY_ADMIN_PORT=12019

# ── Database ──────────────────────────────────────────────────────────────
# Postgres 17 (postgres:17-alpine pinned by digest in docker-compose.yml).
# DB is NOT externally exposed in base compose — only on app_net.
POSTGRES_DB=heartbeat_vault
POSTGRES_USER=heartbeat
# Generate a strong URL-safe password:  openssl rand -hex 24 (hex only — this password is interpolated into DATABASE_URL)
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# Full connection string (derived from the three vars above; used by the app).
# Prefer DATABASE_URL in app config; compose builds it automatically if not set.
# DATABASE_URL=postgresql://heartbeat:change-me@db:5432/heartbeat_vault

# ── App / API ─────────────────────────────────────────────────────────────
# Public URL where the app is reachable (used for links, CORS, callbacks).
# In dev with `tls internal`, this is https://localhost:8443 or http://localhost:8080
APP_URL=http://localhost:18080

# ── Auth / secrets (placeholders — real values required from Phase 3+) ───
# Generate with:  openssl rand -hex 48
# Minimum 32 bytes of entropy; 64 recommended for session/master keys.
# SESSION_SECRET — signs session cookies / JWTs (Phase 3: auth)
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48
# JWT_SECRET — if JWTs are used alongside sessions (Phase 3)
# JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# ── Encryption at rest (Phase 2: envelope encryption) ─────────────────────
# MASTER_KEY — wraps per-secret DEKs (32 bytes, base64). Never commit a real key.
# Generate:  openssl rand -hex 32 (64 hex chars)
# In hardened profile (deferred), this is replaced by Vault/OpenBao Transit.
MASTER_KEY=change-me-generate-with-openssl-rand-base64-32
# KEK version for rotation (Phase 2 will manage this in DB)
# KEK_VERSION=1

# ── TLS / Caddy ───────────────────────────────────────────────────────────
# LAN default is `tls internal` (Caddy internal CA, no env needed).
# For public deployments, set one of:
# Let's Encrypt email (enables ACME):  CADDY_TLS_EMAIL=admin@example.com
# Bring-your-own cert: mount cert/key and set CADDY_TLS=internal|acme|custom
# CADDY_TLS_EMAIL=
# CADDY_TLS=

# ── External services (add keys as integrations land — Phases 5+) ─────────
# Email (SMTP) — Mailpit in dev/CI, real SMTP in prod
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=heartbeat-vault@example.com
# SMTP_USER=
# SMTP_PASS=

# Webhook delivery — no secret until channels are configured
# WEBHOOK_HMAC_SECRET=

# Telegram bot — mock server in dev/CI (Phase 5)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# ── Operational ───────────────────────────────────────────────────────────
# Backup encryption key (Phase 9+) — separate from MASTER_KEY
# BACKUP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Rate limiting / lockout tuning (Phase 3)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# Scheduler tuning (Phase 4)
# SCHEDULER_TICK_MS=30000
# GRACE_PERIOD_HOURS=48
