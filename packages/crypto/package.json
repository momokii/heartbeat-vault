{
  "name": "@heartbeat-vault/crypto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "default": "./dist/envelope.js"
    },
    "./asymmetric": {
      "types": "./dist/asymmetric.d.ts",
      "default": "./dist/asymmetric.js"
    },
    "./sharing": {
      "types": "./dist/sharing.d.ts",
      "default": "./dist/sharing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "1.8.0",
    "@node-rs/argon2": "2.2.1",
    "libsodium-wrappers": "0.8.4",
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
